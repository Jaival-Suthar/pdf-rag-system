APP_NAME=pdf-rag-system
APP_ENV=development
DEBUG=false
DATA_DIR=./data
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdf_chunks
GENERATION_PROVIDER_URL=http://localhost:4000/v1/generate
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=384
EMBEDDING_VERSION=bge-small-en-v1.5
RE_RANK_ENABLED=false
RE_RANK_MODEL_NAME=BAAI/bge-reranker-base
GENERATION_TIMEOUT_SECONDS=30.0
GENERATION_RETRY_COUNT=2
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=80
PROMPT_TOKEN_BUDGET=3000
DUPLICATE_UPLOAD_POLICY=reject
RETRIEVAL_TOP_K_DEFAULT=5
RERANK_CANDIDATE_K=20
RETRIEVAL_SIMILARITY_THRESHOLD=0.0
